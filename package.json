{
  "name": "hollyngrade.com",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "deploy": "npm run pm2delete pm2 start npm --name $npm_package_name -- start",
    "fulldeploy": "git fetch && git pull origin main && npm run pm2delete && npm run build && pm2 start npm --name $npm_package_name -- start",
    "order": "echo 'fetch, pull, pm2 delete ONLY THIS SITE, run build, pm2 start'",
    "pm2start": "pm2 start npm --name $npm_package_name -- start",
    "pm2delete": "pm2 delete $npm_package_name || true",
    "prisma:gl:pull": "prisma db pull --schema=./prisma-gl/schema.prisma",
    "prisma:gl:generate": "prisma generate --schema=./prisma-gl/schema.prisma",
    "prisma:hg:pull": "prisma db pull --schema=./prisma-hg/schema.prisma",
    "prisma:hg:generate": "prisma generate --schema=./prisma-hg/schema.prisma"
  },
  "dependencies": {
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.0",
    "discord.js": "^14.26.4",
    "mysql2": "^3.23.3",
    "next": "15.5.14",
    "next-auth": "^4.24.11",
    "node-html-parser": "^7.1.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-photo-album": "^3.6.0",
    "yet-another-react-lightbox": "^3.32.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "eslint": "^9",
    "prisma": "^6.5.0",
    "tailwindcss": "^4"
  },
  "browser": {
    "fs": false,
    "path": false,
    "os": false
  }
}
